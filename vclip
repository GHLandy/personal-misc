#!/bin/bash
# $HOME/.bin/vclip

# 用法说明
usage() {
    echo "用法: $0 [-c 配置文件] [-o 输出目录] [-d]"
    echo ""
    echo "选项:"
    echo "  -c, --config FILE  指定配置文件路径 (默认: clip_config.txt)"
    echo "  -o, --output DIR   指定输出目录 (默认: ./output)"
    echo "  -d, --dry-run      只显示将要执行的操作，不实际运行"
    echo "  -b, --bitrate      指定 ffmpeg 的 -b:v 参数 (隐含 -d, --dry-run)"
    echo "  -h, --help         显示此帮助信息"
    echo ""
    echo "配置文件格式:"
    echo "  输入文件|起始时间|结束时间(可选)"
    echo "  示例1: /path/to/video.mp4|00:00:10|00:01:30"
    echo "  示例2: /path/to/video.mp4|00:00:10"
    exit 1
}

# 默认配置
CONFIG_FILE="clip_config.txt"
OUTPUT_DIR="output"
DRY_RUN=false
BIT_RATE=""

# 解析命令行参数
while [[ $# -gt 0 ]]; do
    case $1 in
    -c | --config)
        CONFIG_FILE="$2"
        shift 2
        ;;
    -o | --output)
        OUTPUT_DIR="$2"
        shift 2
        ;;
    -d | --dry-run )
        DRY_RUN=true
        shift
        ;;
    -b | --bitrate)
        BIT_RATE="$2"
        DRY_RUN=true
        shift 2
        ;;
    -h | --help)
        usage
        ;;
    *)
        echo "未知参数: $1"
        usage
        ;;
    esac
done

# 检查配置文件是否存在
if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "错误: 配置文件 '$CONFIG_FILE' 不存在"
    echo ""
    echo "请创建配置文件，格式如下:"
    echo "# 每行格式: 输入文件|起始时间|结束时间(可选)"
    echo ""
    echo "# 示例:"
    echo "/path/to/video.mp4|00:00:10|00:01:30"
    echo "# 注释以 # 开头"
    exit 1
fi

# 检查 ffmpeg 是否安装
if ! command -v ffmpeg &>/dev/null; then
    echo "错误: ffmpeg 未安装"
    echo "请先安装 ffmpeg:"
    echo "  Windows: 下载 ffmpeg 并添加到 PATH"
    echo "  CentOS/RHEL: sudo yum install ffmpeg"
    echo "  Ubuntu/Debian: sudo apt install ffmpeg"
    echo "  macOS: brew install ffmpeg"
    exit 1
fi

# 创建输出目录
mkdir -p "$OUTPUT_DIR"
if [[ $? -ne 0 ]]; then
    echo "错误: 无法创建输出目录 $OUTPUT_DIR"
    exit 1
fi

# 计数器
TOTAL=0
SUCCESS=0
FAILED=0
SKIPPED=0
CLIP_COUNTER=0

echo "=============================================="
echo "开始批量切割MP4文件"
echo "配置文件: $CONFIG_FILE"
echo "输出目录: $OUTPUT_DIR"
echo "=============================================="
echo ""

# 读取配置文件
while IFS= read -r line || [[ -n "$line" ]]; do
    # 跳过空行和注释
    if [[ "$line" =~ ^[[:space:]]*($|#) ]]; then
        continue
    fi

    TOTAL=$((TOTAL + 1))
    CLIP_COUNTER=$((CLIP_COUNTER + 1))

    # 解析行: 输入文件|起始时间|结束时间|输出文件名(可选)
    IFS='|' read -r input_file start_time end_time <<<"$line"

    # 去除可能的前后空格
    input_file=$(echo "$input_file" | xargs)
    start_time=$(echo "$start_time" | xargs)
    end_time=$(echo "$end_time" | xargs)
    output_name=$(echo "$input_file" | xargs)

    # 验证必填字段
    if [[ -z "$input_file" || -z "$start_time" ]]; then
        echo "[错误] 行 $TOTAL: 缺少必要字段"
        echo "  行内容: $line"
        FAILED=$((FAILED + 1))
        CLIP_COUNTER=$((CLIP_COUNTER - 1))
        continue
    fi

    # 检查输入文件是否存在
    if [[ ! -f "$input_file" ]] && [[ "$DRY_RUN" != true ]]; then
        echo "[错误] 行 $TOTAL: 输入文件不存在"
        echo "  输入文件: $input_file"
        FAILED=$((FAILED + 1))
        CLIP_COUNTER=$((CLIP_COUNTER - 1))
        continue
    fi

    # 确保输出文件名在输出目录中是唯一的
    output_file="$OUTPUT_DIR/$output_name"
    if [[ -e "$output_file" && "$DRY_RUN" == false ]]; then
        # 如果文件已存在，添加序号
        base_name="${output_name%.*}"
        extension="${output_name##*.}"
        count=1

        while [[ -e "$output_file" ]]; do
            if [[ "$base_name" != "$extension" ]]; then
                # 有扩展名的情况
                output_name="${base_name}_${count}.${extension}"
            else
                # 无扩展名的情况
                output_name="${base_name}_${count}"
            fi
            output_file="$OUTPUT_DIR/$output_name"
            count=$((count + 1))
        done
        echo "[注意] 输出文件已存在，重命名为: $output_name"
    fi

    echo "=============================================="
    echo "处理 [$CLIP_COUNTER]:"
    echo "输入文件: $input_file"
    echo "起始时间: $start_time"
    echo "结束时间: ${end_time:-未配置}"
    echo "输出文件: $output_file"

    if [[ "$DRY_RUN" == true ]]; then
        echo "将执行:"
        if [[ -z $BIT_RATE ]] && [[ -z $end_time ]]; then
            echo "  ffmpeg -ss $start_time -i \"$input_file\" -c:v copy -c:a copy \"$output_file\""
        elif [[ -z $BIT_RATE ]] && [[ -n $end_time ]]; then
            duration=$(time_diff "$start_time" "$end_time")
            echo "  ffmpeg -ss $start_time -i \"$input_file\" -t $duration -c:v copy -c:a copy \"$output_file\""
        elif [[ -n $BIT_RATE ]] && [[ -z $end_time ]]; then
            echo "  ffmpeg -ss $start_time -i \"$input_file\" -c:v libx264 -b:v \"$BIT_RATE\" -c:a copy \"$output_file\""
        else
            duration=$(time_diff "$start_time" "$end_time")
            echo "  ffmpeg -ss $start_time -i \"$input_file\" -t $duration -c:v libx264 -b:v \"$BIT_RATE\" -c:a copy \"$output_file\""
        fi
        SKIPPED=$((SKIPPED + 1))
    else
        echo "正在处理..."

        # 执行 ffmpeg 命令
        TEMP_ERROR_FILE="ffmpeg_error_$$.log"
        if [[ -z $end_time ]]; then
            ffmpeg -ss "$start_time" -i "$input_file" -c:v copy -c:a copy -y "$output_file" 2>"$TEMP_ERROR_FILE"
        else
            duration=$(time_diff "$start_time" "$end_time")
            ffmpeg -ss "$start_time" -i "$input_file" -t "$duration" -c:v copy -c:a copy -y "$output_file" 2>"$TEMP_ERROR_FILE"
        fi

        if [[ $? -eq 0 ]]; then
            # 检查输出文件是否创建成功
            if [[ -f "$output_file" ]]; then
                # Windows兼容的获取文件大小方法
                if command -v du &>/dev/null; then
                    output_size=$(du -h "$output_file" 2>/dev/null | cut -f1)
                else
                    # Windows下使用其他方法获取文件大小
                    output_size=$(ls -lh "$output_file" 2>/dev/null | awk '{print $5}' 2>/dev/null || echo "未知")
                fi
                echo "[成功] 输出文件已创建: $output_name (大小: ${output_size})"
                SUCCESS=$((SUCCESS + 1))
            else
                echo "[错误] 输出文件未创建"
                FAILED=$((FAILED + 1))
            fi
        else
            echo "[错误] ffmpeg处理失败"
            # 显示部分错误信息
            if [[ -f "$TEMP_ERROR_FILE" ]]; then
                tail -5 "$TEMP_ERROR_FILE"
            fi
            FAILED=$((FAILED + 1))
        fi

        # 清理临时错误文件
        if [[ -f "$TEMP_ERROR_FILE" ]]; then
            rm -f "$TEMP_ERROR_FILE" 2>/dev/null
        fi
    fi
    echo ""
done <"$CONFIG_FILE"
